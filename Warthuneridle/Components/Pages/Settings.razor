@page "/settings"
@rendermode InteractiveServer
@using Warthuneridle.Components.Customs

<h3>Settings</h3>
<InputSelect class="form-select w-auto" @bind-Value="selectedCategory" @bind-Value:after="OnCategorySelected">
    @foreach (var category in vehicleCategory)
    {
        <option value="@category">@category</option>
    }
</InputSelect>

@if (isCategorySelected)
{
    <h4>Hello world!</h4>

    @switch(selectedCategory)
    {
        case "Air":
            <h4>Air category selected</h4>
            break;
        case "Ground":
            <h4>Ground category selected</h4>
            <GroundForm OnVehicleCreated=SaveNewVehicle />
            break;
        case "Naval":
            <h4>Naval category selected</h4>
            break;
    }
}