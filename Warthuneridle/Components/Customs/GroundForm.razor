@using Warthuneridle.Models


<EditForm Model="newGroundVehicle" OnValidSubmit="CreateVehicle">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label">Name</label>
        <InputText class="form-control" @bind-Value="newGroundVehicle.VehicleName" />
    </div>
    <div class="col-md-8">
        <label class="form-label">Vehicle type</label>
        <InputSelect class="form-select w-auto" @bind-Value="vType" @bind-Value:after="OnTypeChange">
            @foreach (var type in VehicleTypes.ListGround())
            {
                <option value="@type.Name">@type.Name</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-8">
        <label class="form-label">Techtree position</label>
        <InputSelect class="form-select w-auto" @bind-Value="newGroundVehicle.TechTreePosition">
            @foreach(var pos in Enum.GetValues(typeof(TechTreePositions)).Cast<TechTreePositions>()){
                <option value="@pos">@pos</option>
            }
        </InputSelect>
    </div>
    <div class="row">
        <div class="col-md-4 mb-3">
            <label class="form-label">Main Gun Caliber</label>
            <InputNumber class="form-control" @bind-Value="newGroundVehicle.MainGunCaliber" min="0" max="800" step="0.1"/>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Gun amount (0/1/2)</label>
            <InputNumber class="form-control" @bind-Value="newGroundVehicle.HasMultipleMainGuns" min="0" max="2" step="1"/>
        </div>
        <div class="col-md-4 mb-3">
            <label class="form-label">Weight (tons)</label>
            <InputNumber class="form-control" @bind-Value="newGroundVehicle.WeightInTons" min="0" max="500" step="0.1"/>
        </div>
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="newGroundVehicle.HasAuxiliaryWeapons" />
        <label class="form-check-label">Has auxiliary weapons</label>
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="newGroundVehicle.HasTracks" />
        <label class="form-check-label">Has tracks</label>
    </div>
    <ValidationSummary />
    <button type="submit" class="btn btn-primary">Add Vehicle</button>
    <button type="button" class="btn btn-secondary ms-2" @onclick="Reset">Reset</button>
</EditForm>

